{
  "name": "store-sales-report-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/host",
    "apps/store-sales-report",
    "packages/store-sales-api"
  ],
  "scripts": {
    "dev": "concurrently -k -n host,remote -c blue,green \"npm:dev:host\" \"npm:dev:remote\"",
    "dev:host": "npm run dev --workspace @store-sales-report/host",
    "dev:remote": "npm run dev --workspace @store-sales-report/remote",
    "build": "npm run build:remote && npm run build:web-component && npm run build:host",
    "build:host": "npm run build --workspace @store-sales-report/host",
    "build:remote": "npm run build --workspace @store-sales-report/remote",
    "build:web-component": "npm run build:web-component --workspace @store-sales-report/remote",
    "preview": "concurrently -k -n host,remote -c blue,green \"npm:preview:host\" \"npm:preview:remote\"",
    "preview:host": "npm run preview --workspace @store-sales-report/host",
    "preview:remote": "npm run preview --workspace @store-sales-report/remote"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
