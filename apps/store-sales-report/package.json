{
  "name": "@store-sales-report/widget",
  "version": "0.1.0",
  "description": "Embeddable Store Sales Report Web Component",
  "type": "module",
  "files": [
    "dist-web-component",
    "dist-vue",
    "types",
    "src/types/report.ts",
    "README.md"
  ],
  "exports": {
    "./web-component": {
      "types": "./types/web-component.d.ts",
      "import": "./dist-web-component/store-sales-report.js",
      "default": "./dist-web-component/store-sales-report.js"
    },
    "./vue": {
      "types": "./types/vue-component.d.ts",
      "import": "./dist-vue/store-sales-report.js",
      "default": "./dist-vue/store-sales-report.js"
    },
    "./vue.css": {
      "import": "./dist-vue/store-sales-report.css",
      "default": "./dist-vue/store-sales-report.css"
    }
  },
  "sideEffects": [
    "./dist-web-component/store-sales-report.js",
    "./dist-vue/store-sales-report.css"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4174",
    "build": "vue-tsc -b && vite build",
    "build:web-component": "vite build --config vite.web-component.config.ts",
    "build:vue-component": "vite build --config vite.vue-component.config.ts",
    "prepack": "npm run build:web-component && npm run build:vue-component",
    "preview": "vite preview --host 0.0.0.0 --port 4174"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tanstack/vue-table": "^9.3.1",
    "@vueuse/core": "^15.0.0",
    "echarts": "^6.1.0",
    "@module-federation/vite": "^1.0.0",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.10",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.18"
  }
}
